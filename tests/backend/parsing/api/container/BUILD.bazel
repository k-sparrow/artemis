load("@//tools/testing:pytest.bzl", py_test = "pytest_test")
load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        requirement("httpx"),
        requirement("minio"),
        requirement("pytest"),
        requirement("testcontainers"),
    ],
)

py_test(
    name = "test_smoke",
    srcs = ["test_smoke.py"],
    data = ["complex-tables.pdf"],
    env = {"TC_MAX_TRIES": "1000000000"},
    deps = [
        ":conftest",
        "//src/lib/core/ingestion:types",
        requirement("httpx"),
        requirement("minio"),
        requirement("pydantic"),
        requirement("pytest"),
        requirement("pytest-asyncio"),
    ],
)

py_test(
    name = "test_async_chain",
    srcs = ["test_async_chain.py"],
    data = ["//tools/fixtures/docs:all_fixtures"],
    env = {"TC_MAX_TRIES": "1000000000"},
    deps = [
        ":conftest",
        "//src/lib/core/ingestion:types",
        requirement("httpx"),
        requirement("minio"),
        requirement("pytest"),
        requirement("pytest-asyncio"),
    ],
)

py_test(
    name = "test_ray_engine",
    srcs = ["test_ray_engine.py"],
    data = ["//tools/fixtures/docs:all_fixtures"],
    env = {"TC_MAX_TRIES": "1000000000"},
    deps = [
        "//src/backend/parsing/lib:artifact",
        "//src/backend/parsing/lib:docling_client",
        "//tests/lib/testcontainers/docling:pkg",
        requirement("pytest"),
        requirement("pytest-asyncio"),
    ],
)
