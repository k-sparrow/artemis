  {
    "name": "list_objects",
    "inputSchema": {
      "properties": {
        "namespace_id": {
          "description": "UUID of the namespace to list objects from.",
          "title": "Namespace Id",
          "type": "string"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional group UUID to filter results. A group represents a logical ownership boundary such as a data source connector or an upload session. Omit to return all objects in the namespace.",
