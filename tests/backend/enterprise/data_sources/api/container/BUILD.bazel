load("@//tools/testing:pytest.bzl", py_test = "pytest_test")
load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

py_library(
    name = "pkg",
    srcs = ["__init__.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//tests/lib/testcontainers:migrations",
        "//tests/lib/testcontainers/kafka:pkg",
        requirement("asyncpg"),
        requirement("fastapi"),
        requirement("httpx"),
        requirement("kafka-python-ng"),
        requirement("psycopg"),
        requirement("psycopg-binary"),
        requirement("pytest"),
        requirement("sqlalchemy"),
        requirement("testcontainers"),
        requirement("wiremock"),
    ],
)

py_test(
    name = "test_api",
    srcs = ["test_api.py"],
    data = ["//src/backend/alembic:tarball.dev"],
    tags = [
        "container",
        "integration",
        "local",  # disable Bazel sandbox so Docker volume mounts see the real host filesystem
    ],
    deps = [
        ":conftest",
        "//tests/lib/testcontainers/kafka:pkg",
        requirement("fastapi"),
        requirement("httpx"),
        requirement("kafka-python-ng"),
        requirement("pytest"),
        requirement("wiremock"),
    ],
)
