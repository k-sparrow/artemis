"""Reproducible checks that the docling-jobkit Ray-serde patch is actually what
ships — see //tools/oci/images/docling for the image build itself and the
full root-cause writeup.

1. models.py_patch_test: cheap, instant check that the patch source itself is
   correct. Doesn't prove anything about the built image.
2. test_ray_serde_patch_is_live: the one that actually matters — runs a real
   import inside a real container of the built image. File-existence/content
   checks at a path alone can't catch the class of bug this is guarding
   against (a `docker load` layer merge silently shadowing the real
   `docling_jobkit` site-packages tree with a sparse, unpatched one — see
   //tools/oci/images/docling for the full root-cause writeup); only an
   actual import inside a real running container does.
"""

load("@//tools/testing:pytest.bzl", py_test = "pytest_test")
load("@aspect_bazel_lib//lib:testing.bzl", "assert_contains")
load("@pip//:requirements.bzl", "requirement")

# Content check: "chunk: DocumentChunk = Field(" can only appear as a literal
# substring if the field is the bare, unsubscripted class -- the broken upstream
# form ("chunk: DocumentChunk[Any, Any] = Field(") breaks that exact adjacency,
# so this fails loudly against a reverted/un-patched file.
assert_contains(
    name = "models.py_patch_test",
    actual = "//tools/oci/images/docling:models.py",
    expected = "chunk: DocumentChunk = Field(",
)

# Prerequisite: bazel run //tools/oci/images/docling:tarball
py_test(
    name = "test_patched_image",
    srcs = ["test_patched_image.py"],
    tags = ["integration"],
    deps = [
        requirement("docker"),
        requirement("pytest"),
    ],
)
