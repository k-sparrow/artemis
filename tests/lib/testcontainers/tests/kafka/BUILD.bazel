load("@//tools/testing:pytest.bzl", py_test = "pytest_test")
load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(
    default_visibility = ["//visibility:private"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//tests/lib/testcontainers/kafka:pkg",
        requirement("pytest"),
        requirement("testcontainers"),
    ],
)

py_test(
    name = "test_kafka",
    srcs = ["test_kafka.py"],
    env = {},
    tags = ["unit"],
    deps = [
        "//tests/lib/testcontainers/kafka",
        requirement("kafka-python-ng"),
        requirement("pytest"),
        requirement("testcontainers"),
    ],
)

