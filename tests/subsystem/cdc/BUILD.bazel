load("@//tools/testing:pytest.bzl", py_test = "pytest_test")
load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

py_library(
    name = "pkg",
    srcs = ["__init__.py"],
    visibility = ["//visibility:public"],
)

# Subsystem tests: CDC pipeline — Debezium WAL → ksqlDB → JDBC sink → DB tables
#
# Inserts rows into ingestion_status (the real Postgres WAL path),
# then polls ingested_objects until the JDBC sink writes it.
#
# Prerequisites:
#   bazel run //tools/oci/images:kafka-connect.tarball
#   bazel run //src/backend/alembic:tarball.dev
#   bazel run //tools/oci/images/ksqldb:artemis_init_tarball
py_test(
    name = "test_cdc_pipeline",
    srcs = [
        "conftest.py",
        "test_cdc_pipeline.py",
    ],
    data = ["//src/backend/alembic:tarball.dev"],
    tags = ["integration"],
    deps = [
        "//src/backend/storage/api:models",
        "//tests/lib/testcontainers:migrations",
        "//tests/lib/testcontainers/kafka:pkg",
        requirement("fastapi"),
        requirement("httpx"),
        requirement("psycopg"),
        requirement("psycopg-binary"),
        requirement("pytest"),
        requirement("sqlalchemy"),
        requirement("testcontainers"),
    ],
)
