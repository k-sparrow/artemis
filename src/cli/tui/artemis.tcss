/* Artemis TUI — dark theme */

$artemis-accent: #7c6af7;
$artemis-accent-dark: #5a4fcf;
$artemis-bg: #0d0d14;
$artemis-surface: #13131f;
$artemis-panel: #1a1a2e;
$artemis-border: #2a2a4a;
$artemis-text: #c8c8e8;
$artemis-text-dim: #6a6a9a;

Screen {
    background: $artemis-bg;
    color: $artemis-text;
}

Header {
    background: $artemis-panel;
    color: $artemis-accent;
    text-style: bold;
}

Footer {
    background: $artemis-panel;
    color: $artemis-text-dim;
}

#source-tree {
    height: 1fr;
    background: $artemis-surface;
    border: solid $artemis-border;
    padding: 0 1;
    scrollbar-color: $artemis-accent;
}

Tree > .tree--cursor {
    background: $artemis-accent-dark;
    color: $artemis-text;
}

Tree > .tree--highlight {
    background: $artemis-panel;
}

/* Detail screen */
#info, #tasks {
    padding: 1 2;
    height: auto;
    background: $artemis-surface;
    border: solid $artemis-border;
    margin-bottom: 1;
}

#actions {
    height: auto;
    padding: 0 2;
}

#actions Button {
    margin-right: 1;
    min-width: 14;
}

/* Create form */
CreateScreen {
    align: center middle;
}

#form {
    padding: 1 2;
    width: 64;
    height: auto;
    background: $artemis-surface;
    border: solid $artemis-border;
}

#form-buttons {
    height: auto;
    margin-top: 1;
}

#form-title {
    color: $artemis-accent;
    text-style: bold;
    margin-bottom: 1;
}

#form Label {
    color: $artemis-text-dim;
    margin-top: 1;
}

#inp-org {
    opacity: 0.6;
}

#form Checkbox {
    margin-top: 1;
    background: transparent;
    border: none;
    color: $artemis-text;
}

#inp-file-extensions {
    max-height: 4;
    border: solid $artemis-border;
}

Input {
    background: $artemis-panel;
    border: solid $artemis-border;
    color: $artemis-text;
}

Input:focus {
    border: solid $artemis-accent;
}

/* Home screen */
#home-content {
    align: center middle;
    height: 1fr;
}

#home-title {
    color: $artemis-accent;
    text-style: bold;
    text-align: center;
    margin-bottom: 0;
}

#home-gateway {
    color: $artemis-text-dim;
    text-align: center;
    margin-bottom: 1;
}

#home-tables {
    height: auto;
    width: auto;
}

#home-metrics {
    width: 40;
    height: auto;
    background: $artemis-surface;
    border: solid $artemis-border;
    margin-right: 2;
}

#home-activity {
    width: 100;
    height: auto;
    background: $artemis-surface;
    border: solid $artemis-border;
}

/* Connectors screen */
#connectors-body {
    height: 1fr;
}

#filter-input {
    height: 3;
    background: $artemis-panel;
    border: solid $artemis-accent;
}

/* Objects screen */
#objects-content {
    height: 1fr;
}

#objects-toolbar {
    height: 3;
    padding: 0 1;
}

#ns-select-label {
    color: $artemis-accent;
    text-style: bold;
    height: 3;
    content-align: left middle;
    padding-right: 1;
}

#ns-select {
    width: 50;
}

#objects-body {
    height: 1fr;
}

#objects-tree-panel {
    /* File tree is the primary view (Epic 16.5) — wider than the tasks panel. */
    width: 2fr;
    border-right: solid $artemis-border;
}

#objects-tasks-panel {
    width: 1fr;
}

#tree-label, #tasks-label, #objects-hint {
    color: $artemis-accent;
    text-style: bold;
    padding: 0 1;
    height: 1;
}

#objects-filetree {
    height: 1fr;
    background: $artemis-surface;
    padding: 0 1;
}

#objects-tasks {
    height: 1fr;
    background: $artemis-surface;
}

/* Health screen */
#health-table {
    height: 1fr;
    background: $artemis-surface;
    border: solid $artemis-border;
    margin: 1 2;
}

/* Confirm modal */
ConfirmScreen {
    align: center middle;
    background: $artemis-bg 70%;
}

ConfirmScreen > * {
    background: $artemis-panel;
    border: solid $artemis-border;
    padding: 2 4;
    width: auto;
    height: auto;
}

ConfirmScreen Label {
    color: $artemis-text;
    text-style: bold;
    margin-bottom: 1;
}

ConfirmScreen Horizontal {
    height: auto;
    align: center middle;
}

ConfirmScreen Button {
    margin: 0 1;
}

/* Button variants */
Button.-success {
    background: #1a3a2a;
    color: #4ade80;
    border: solid #2a5a3a;
}

Button.-success:hover {
    background: #2a5a3a;
}

Button.-error {
    background: #3a1a1a;
    color: #f87171;
    border: solid #5a2a2a;
}

Button.-error:hover {
    background: #5a2a2a;
}

Button.-warning {
    background: #3a2e00;
    color: #fbbf24;
    border: solid #5a4a00;
}

Button.-warning:hover {
    background: #5a4a00;
}

Button {
    background: $artemis-panel;
    color: $artemis-text;
    border: solid $artemis-border;
}

Button:hover {
    background: $artemis-accent-dark;
    color: $artemis-text;
}
