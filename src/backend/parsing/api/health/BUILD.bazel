load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(
    default_visibility = [
        "//src/backend/parsing/api:__subpackages__",
        "//tests/backend/parsing/api:__subpackages__",
    ],
)

py_library(
    name = "checks",
    srcs = ["checks.py"],
    deps = [
        requirement("aiohttp"),
        requirement("fastapi-healthchecks"),
    ],
)

py_library(
    name = "router",
    srcs = ["router.py"],
    deps = [
        ":checks",
        "//src/backend/parsing/api:config",
        requirement("fastapi-healthchecks"),
    ],
)

py_library(
    name = "pkg",
    srcs = ["__init__.py"],
    deps = [":router"],
)
