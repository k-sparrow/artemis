load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(
    default_visibility = [
        "//src/backend/storage/api:__pkg__",
        "//tests/backend/storage/api:__subpackages__",
    ],
)

py_library(
    name = "pkg",
    srcs = [
        "__init__.py",
    ],
    visibility = ["//src/backend/storage/api:__pkg__"],
    deps = [
        ":router",
    ],
)

py_library(
    name = "router",
    srcs = [
        "router.py",
    ],
    deps = [
        ":checks",
        "//src/backend/storage/api:config",
        "//src/backend/storage/api:dependencies",
        requirement("fastapi-healthchecks"),
    ],
)

py_library(
    name = "checks",
    srcs = [
        "checks.py",
    ],
    deps = [
        requirement("fastapi-healthchecks"),
        requirement("minio"),
    ],
)
