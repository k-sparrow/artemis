load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(default_visibility = ["//src/backend/indexing/api:__subpackages__"])

py_library(
    name = "pkg",
    srcs = [
        "__init__.py",
    ],
    deps = [
        ":base",
        ":qdrant",
    ],
)

py_library(
    name = "qdrant",
    srcs = [
        "qdrant.py",
    ],
    deps = [
        ":base",
        "//src/backend/indexing/lib/vectorstore:pkg",
        requirement("langchain-core"),
        requirement("langchain-qdrant"),
        requirement("qdrant-client"),
    ],
)

py_library(
    name = "base",
    srcs = [
        "base.py",
    ],
    deps = [
        requirement("langchain-core"),
    ],
)
