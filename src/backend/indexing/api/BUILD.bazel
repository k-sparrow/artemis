# gazelle:python_root

load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_oci//oci:defs.bzl", oci_load = "oci_tarball", "oci_push")
load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@pip//:requirements.bzl", "requirement")

load("//tools/oci:py_layer.bzl", "py_oci_image")
load("//tools/server:uvicorn.bzl", "uvicorn_dev_server")
load("//tools/server:celery.bzl", "celery_worker")

default_visibility = ["//visibility:private"]

# Equivalent to cmdline:
#  `uvicorn main:app --host localhost --port 9002`
uvicorn_dev_server(
    name = "dev",
    args = [
        "main:app",
        "--host",
        "localhost",
        "--port",
        "9002",
        "--reload",
    ],
    imports = ["."],
    data = ["//:.env"],
    visibility = ["//visibility:public"],
    deps = [
        ":backend-main",
    ],
)


py_library(
    name = "backend-main",
    srcs = [
        "__init__.py",
        "main.py",
    ],
    imports = ["."],
    deps = [
        ":config",
        ":service",
        requirement("aiohttp"),
        requirement("fastapi"),
        requirement("langchain-core"),
        requirement("langchain-huggingface"),
        requirement("langchain-qdrant"),
        requirement("python-multipart"),
    ]
)

py_library(
    name = "service",
    srcs = [
        "service.py",
    ],
    deps = [
        ":config",
        "//src/backend/indexing/client/generated/api:pkg",
        "//src/backend/indexing/client/generated/api/default:pkg",
        "//src/backend/indexing/client/generated/models:pkg",
        "//src/backend/indexing/client/generated:pkg",
        requirement("fastapi"),
        requirement("langchain-core"),
    ]
)

py_library(
    name = "config",
    srcs = [
        "config.py",
    ],
    deps = [
        requirement("pydantic"),
        requirement("pydantic-settings"),
    ],
)

tar(
    name = "env",
    srcs = ["//:.env"],
)

py_oci_image(
    name = "image",
    base = "@ubuntu",
    binary = ":dev",
    entrypoint = [
        "/src/backend/indexing/api/dev",
        "main:app",
        "--host",
        "0.0.0.0",  # this should allow connections from host
        "--port",
        "9002",
    ],
    exposed_ports = ["9002"],
    tars = [
        ":env",
    ],
    visibility = ["//src/backend:__pkg__"],
)


# $ bazel run //src/backend/indexing/api:tarball
oci_load(
    name = "tarball",
    image = ":image",
    repo_tags = ["celery-ingestion/backend:latest"],
)

oci_push(
    name = "push",
    image = ":image",
    repository = "localhost:5000/celery-ingestion-backend",
    remote_tags = ["latest"]
)
