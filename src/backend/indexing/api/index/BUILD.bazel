load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

py_library(
    name = "service",
    srcs = ["service.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/backend/indexing/api:dependencies",
        "//src/lib/core/ingestion:exceptions",
        "//src/lib/core/ingestion:pkg",
        requirement("fastapi"),
        requirement("httpx"),
    ],
)

py_library(
    name = "router",
    srcs = ["router.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":service",
        "//src/backend/indexing/api:dependencies",
        "//src/lib/backend/logging:pkg",
        "//src/lib/core/ingestion:pkg",
        requirement("fastapi"),
    ],
)

py_library(
    name = "pkg",
    srcs = ["__init__.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":router",
    ],
)
