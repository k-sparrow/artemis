load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(default_visibility = [
    "//src/backend/indexing/api:__pkg__",
    "//tests:__subpackages__",
])

py_library(
    name = "retriever",
    srcs = [
        "retriever.py",
    ],
    deps = [
        "//src/lib/core/retrieval:params",
        "//src/lib/core/retrieval:parent_page",
        "//src/lib/core/retrieval/adapters:base",
        requirement("langchain"),
        requirement("langchain-core"),
        requirement("pydantic"),
    ],
)

py_library(
    name = "service",
    srcs = [
        "service.py",
    ],
    deps = [
        ":retriever",
        "//src/lib/core/ingestion/pipeline:parent_page",
        "//src/lib/core/retrieval:parent_page",
        "//src/lib/core/retrieval/adapters:base",
        requirement("langchain-core"),
    ],
)

py_library(
    name = "utils",
    srcs = [
        "utils.py",
    ],
    deps = [
        requirement("fastapi"),
    ],
)

py_library(
    name = "router",
    srcs = [
        "router.py",
    ],
    deps = [
        ":service",
        ":utils",
        requirement("fastapi"),
        requirement("langchain-core"),
        requirement("langserve"),
        requirement("sse-starlette"),
    ],
)

py_library(
    name = "pkg",
    srcs = [
        "__init__.py",
    ],
    deps = [
        ":router",
    ],
)
