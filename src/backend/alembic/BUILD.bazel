load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@pip//:requirements.bzl", "requirement")
load("@rules_oci//oci:defs.bzl", oci_load = "oci_tarball")
load("//tools/oci:py_layer.bzl", "py_oci_image")

py_binary(
    name = "run_migrations",
    srcs = ["run_migrations.py"],
    data = [
        "env.py",
        "script.py.mako",
    ] + glob(["versions/*.py"]),
    deps = [
        "//src/backend/controller/worker/backend:models",
        "//src/backend/enterprise/data_sources/api:models",
        "//src/backend/storage/api:models",
        "//src/lib/backend/db:base",
        requirement("alembic"),
        requirement("psycopg"),
        requirement("psycopg-binary"),
        requirement("sqlalchemy"),
    ],
)

py_oci_image(
    name = "image",
    base = "@ubuntu",
    binary = ":run_migrations",
    entrypoint = ["/src/backend/alembic/run_migrations"],
    visibility = ["//src/backend:__pkg__"],
)

oci_load(
    name = "tarball.dev",
    image = ":image",
    repo_tags = ["artemis/db-migrations:dev"],
    visibility = [
        "//src:__pkg__",
        "//tests:__subpackages__",
    ],
)
