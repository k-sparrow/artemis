load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(default_visibility = ["//src:__subpackages__"])

py_library(
    name = "pkg",
    srcs = [
        "__init__.py",
    ],
    deps = [
        ":config",
        ":processors",
    ],
)

py_library(
    name = "processors",
    srcs = [
        "processors.py",
    ],
    deps = [
        requirement("opentelemetry-api"),
    ],
)

py_library(
    name = "config",
    srcs = [
        "config.py",
    ],
    deps = [
        ":processors",
        requirement("structlog"),
    ],
)
