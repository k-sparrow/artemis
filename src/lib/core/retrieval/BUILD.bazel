load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "pkg",
    srcs = [
        "__init__.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":configurable",
        ":params",
    ],
)

py_library(
    name = "configurable",
    srcs = [
        "configurable.py",
    ],
    deps = [
        requirement("langchain"),
    ],
)

# Parent-page dereference decorator — composes over any base retriever.
py_library(
    name = "parent_page",
    srcs = [
        "parent_page.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("langchain"),
        requirement("langchain-core"),
        requirement("pydantic"),
    ],
)

py_library(
    name = "params",
    srcs = [
        "params.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("qdrant-client"),
    ],
)
