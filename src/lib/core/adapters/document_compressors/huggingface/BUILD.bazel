load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(
    default_visibility = [
        "//src:__subpackages__",
        "//tests:__subpackages__",
    ],
)

py_library(
    name = "pkg",
    srcs = [
        "__init__.py",
    ],
    deps = [
        ":reranker",
    ],
)

py_library(
    name = "reranker",
    srcs = [
        "reranker.py",
    ],
    deps = [
        ":client",
        requirement("aiohttp"),
        requirement("huggingface-hub"),
        requirement("langchain-core"),
        requirement("pydantic"),
        requirement("typing-extensions"),
    ],
)

py_library(
    name = "client",
    srcs = [
        "_client.py",
    ],
    deps = [
        requirement("huggingface-hub"),
    ],
)
