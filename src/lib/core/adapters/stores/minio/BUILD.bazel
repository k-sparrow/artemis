load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(
    default_visibility = [
        "//src/backend/controller:__subpackages__",
        "//tests/backend/controller:__subpackages__",
        "//tests/lib/core/adapters/stores:__subpackages__",
    ],
)

py_library(
    name = "pkg",
    srcs = ["__init__.py"],
    deps = [":parsed_chunks"],
)

py_library(
    name = "parsed_chunks",
    srcs = ["parsed_chunks.py"],
    deps = [
        "//src/lib/core/ingestion:types",
        requirement("minio"),
        requirement("pydantic"),
    ],
)

# MinIO-backed BlobStore — broadly visible so parsing + indexing can read/write
# artifacts directly (claim-check data plane).
py_library(
    name = "blob",
    srcs = ["blob.py"],
    visibility = [
        "//src:__subpackages__",
        "//tests:__subpackages__",
    ],
    deps = [
        "//src/lib/core/adapters/stores/base:blob",
        requirement("minio"),
    ],
)
