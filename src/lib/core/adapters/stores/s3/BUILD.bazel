load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = [
    "//src:__subpackages__",
    "//tests:__subpackages__",
])

py_library(
    name = "pkg",
    srcs = ["__init__.py"],
    deps = [
        ":store",
    ],
)

# S3 ByteStore — native-async via aiobotocore; server-agnostic (MinIO/Ceph/AWS).
py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        requirement("aiobotocore"),
        requirement("botocore"),
        requirement("langchain-core"),
    ],
)
