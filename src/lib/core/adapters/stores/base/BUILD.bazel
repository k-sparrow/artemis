load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = [
    "//src/lib/core:__subpackages__",
    "//tests/lib/core:__subpackages__",
])

py_library(
    name = "pkg",
    srcs = ["__init__.py"],
    deps = [
        ":store",
    ],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    visibility = ["//visibility:private"],
    deps = [
        requirement("langchain"),
        requirement("langchain-core"),
    ],
)

# BlobStore port — dependency-light (stdlib only), broadly visible so the
# backend services can depend on it directly.
py_library(
    name = "blob",
    srcs = ["blob.py"],
    visibility = [
        "//src:__subpackages__",
        "//tests:__subpackages__",
    ],
)
