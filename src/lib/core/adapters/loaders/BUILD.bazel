load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(default_visibility = ["//src:__subpackages__"])

py_library(
    name = "pkg",
    srcs = [
        "__init__.py",
    ],
    deps = [
        ":docling",
    ],
)

py_library(
    name = "docling",
    srcs = [
        "docling.py",
    ],
    deps = [
        requirement("docling"),
        requirement("httpx"),
        requirement("langchain-core"),
        requirement("langchain-text-splitters"),
    ],
)
