load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip//:requirements.bzl", "requirement")

package(
    default_visibility = [
        "//src:__subpackages__",
        "//tests:__subpackages__",
    ],
)

py_library(
    name = "pkg",
    srcs = [
        "__init__.py",
    ],
    deps = [
        ":qdrant",
    ],
)

py_library(
    name = "qdrant",
    srcs = [
        "qdrant.py",
    ],
    deps = [
        requirement("langchain-core"),
        requirement("langchain-qdrant"),
        requirement("numpy"),
        requirement("qdrant-client"),
    ],
)
