load("@rules_python//python:defs.bzl", "py_binary")

# Base generator binary — used as a tool in the genrules below.
py_binary(
    name = "compose_generator",
    srcs = ["compose_generator.py"],
    data = ["docker-compose.tmpl.yaml"],
    visibility = ["//visibility:public"],
)

# Dev compose artifact — consumed by //deployment/docker:docker_compose.update.
genrule(
    name = "docker_compose_dev",
    srcs = ["docker-compose.tmpl.yaml"],
    outs = ["docker-compose.dev.yaml"],
    cmd = "$(location :compose_generator) --mode dev --template $(location :docker-compose.tmpl.yaml) --output $@",
    tools = [":compose_generator"],
    visibility = ["//deployment/docker:__pkg__"],
)

# Test artifact — CPU Docling, no GPU mounts, TEI as a container.
# Used by e2e tests via testcontainers.compose.DockerCompose.
#
#   bazel build //tools/docker:docker_compose_test
genrule(
    name = "docker_compose_test",
    srcs = ["docker-compose.tmpl.yaml"],
    outs = ["docker-compose.test.yaml"],
    cmd = "$(location :compose_generator) --mode test --template $(location :docker-compose.tmpl.yaml) --output $@",
    tools = [":compose_generator"],
    visibility = ["//tests:__subpackages__"],
)

# Release/staging artifact — tagged artemis images (${ARTEMIS_VERSION}), dev-tools
# dropped, gateway-only ingress. Consumed by //deployment/docker:docker_compose.update.
#
# DOCLING_IMAGE is the one image reference not covered by ${ARTEMIS_VERSION} --
# it's an OCI-patched third-party base image (see //tools/oci/images/docling),
# versioned independently via that target's own stamped_tags. This genrule
# reads the last line of :tarball.tags (the STABLE_VERSION-stamped entry, not
# the static :latest dev tag) and passes it through so the release compose
# output pins a real, traceable version instead of a mutable tag. Only
# resolves to a real version under `bazel build ... --stamp`; unstamped
# builds fall back to the same 0.0.0 placeholder stamped_tags always uses.
genrule(
    name = "docker_compose_release",
    srcs = [
        "docker-compose.tmpl.yaml",
        "//tools/oci/images/docling:tarball.tags",
    ],
    outs = ["docker-compose.release.yaml"],
    cmd = """
    docling_image=$$(tail -n1 $(location //tools/oci/images/docling:tarball.tags))
    $(location :compose_generator) --mode release \
        --template $(location :docker-compose.tmpl.yaml) \
        --docling-image "$$docling_image" \
        --output $@
    """,
    tools = [":compose_generator"],
    visibility = ["//deployment/docker:__pkg__"],
)
