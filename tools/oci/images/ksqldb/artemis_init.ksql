-- Artemis ingestion pipeline — KSQLDB stream processing
--
-- Topology A: MinIO S3 → Celery task dispatch
-- --------------------------------------------
--   MinIO S3 bucket notification
--       → artemis.ingestion.storage.s3  (raw S3 event, JSON)
--       → [this file] flatten + reshape
--       → artemis.ingestion.celery.tasks  (Celery v2 task message, JSON, key=namespace_id)
--       → [this file] re-partition by task_id
--       → artemis.ingestion.celery.tasks.routed  (JSON, key=task_id)
--       → Camel Spring RabbitMQ Sink Connector
--           SMT: HeaderFrom$Key   {task_id: <uuid>} key → Kafka header `CamelHeader.id`
--           SMT: InsertHeader adds `CamelHeader.task` = "tasks.ingest"
--           SMT: InsertHeader adds `CamelHeader.CamelSpringRabbitmqContentType` = "application/json"
--       → RabbitMQ → Celery worker `tasks.ingest`
--
-- Topology B: Celery result CDC → ingested_objects + ingestion_tasks
-- ------------------------------------------------------------------
--   Celery worker completes tasks.index → writes IngestionResult to apollo_celery_taskmeta
--       → Debezium PostgreSQL source connector (WAL, REPLICA IDENTITY FULL)
--       → apollo.ingestion.celery.results.public.apollo_celery_taskmeta (Debezium CDC, JSON)
--       → [this file] ExtractNewRecordState unwraps envelope; filter tasks.index SUCCESS
--       → artemis.celery.ingested_objects  (flattened IngestionResult fields)
--           → Debezium JDBC Sink → ingested_objects table (upsert on id)
--       → artemis.celery.ingestion_tasks   (per-task completion record)
--           → Debezium JDBC Sink → ingestion_tasks table (upsert on task_id)
--
-- Why two CSAS hops instead of one?
--   The first CSAS (`artemis-ingestion-celery-tasks`) partitions by namespace_id so
--   that all events for the same namespace land on the same partition, preserving
--   relative ordering of CREATE / MODIFY / DELETE for a given namespace.
--   The second CSAS (`artemis-ingestion-celery-tasks-routed`) re-partitions by
--   task_id so that task_id becomes the Kafka record KEY.
--
-- Why is task_id in the KEY (not the VALUE)?
--   ksqlDB cannot write Kafka record headers in CSAS output.  Promoting task_id
--   into CamelHeader.id (Celery v2 task UUID) requires HeaderFrom$Key on the
--   RabbitMQ sink connector, which reads from the Kafka record KEY.  PARTITION BY
--   task_id makes task_id the KEY and strips it from the VALUE, so the message
--   body is clean args+kwargs only (exact Celery v2 format).  ByteArrayConverter
--   on the value avoids the JsonConverter → HashMap → byte[] conversion error.
--
-- MinIO metadata keys written by the storage service
-- ---------------------------------------------------
--   X-Amz-Meta-Task_id  : str(uuid4)   — Celery task UUID (top-level for HeaderFrom SMT)
--   X-Amz-Meta-Contract : JSON string  — full IngestionTaskDetails (see contract.py)
--
-- Contract JSON structure (IngestionTaskDetails)
-- -----------------------------------------------
--   upload_action  : "create" | "modify" | "delete"
--   s3             : { bucket, object, size }
--   source         : { source, content_type, obj_id, object_type }
--   info           : { namespace_id }
--
-- Celery v2 kwargs contract (tasks.ingest)
-- -----------------------------------------
--   s3           : S3Details       { bucket, object, size }
--   source       : SourceDetails   { source, content_type, obj_id, object_type }
--   upload_action: UploadAction    "CREATE" | "MODIFY" | "DELETE"
--   info         : IngestionInfo   { namespace_id }
--
-- Note: task_id does NOT appear in kwargs — it travels as the Kafka header
-- `CamelHeader.id`, promoted by HeaderFrom$Key on the RabbitMQ sink connector
-- reading from artemis.ingestion.celery.tasks.routed (whose key is task_id).
-- Celery reads this header as the task UUID (protocol v2).
--
-- Note: UploadAction values are uppercase; IngestionTaskDetails.upload_action
-- (storage service) writes lowercase. UCASE() normalises the value.
--
-- Note: EXTRACTJSONFIELD returns STRING for all nested contract fields.
-- Celery worker deserialises these via Pydantic (UUID, str coercions).

-- consume from the earliest available offset
SET 'auto.offset.reset' = 'earliest';


-- ---------------------------------------------------------------------------
-- 1. Raw S3 event stream
--
-- MinIO publishes one event record per PUT/DELETE operation.
-- Only the fields required downstream are declared; the rest are ignored.
-- ---------------------------------------------------------------------------

CREATE OR REPLACE STREAM `artemis-ingestion-storage-s3` (
  EventName  STRING,
  Records    ARRAY<STRUCT<
    s3 STRUCT<
      bucket STRUCT<name STRING>,
      object STRUCT<
        key          STRING,
        userMetadata STRUCT<
          `X-Amz-Meta-Task_id`   STRING,
          `X-Amz-Meta-Contract`  STRING
        >
      >
    >
  >>
)
WITH (
  KAFKA_TOPIC  = 'artemis.ingestion.storage.s3',
  VALUE_FORMAT = 'JSON',
  PARTITIONS   = 1
);


-- ---------------------------------------------------------------------------
-- 2. Flatten and reshape into the Celery v2 task message format
--
-- Output topic: artemis.ingestion.celery.tasks
--
-- The message value matches the kwargs structure expected by tasks.ingest.
-- `task_id` is included as a top-level field so the HeaderFrom SMT on the
-- Camel RabbitMQ Sink Connector can promote it to the `CamelHeader.id`
-- Kafka message header (Celery v2 protocol requirement).
--
-- All contract fields are extracted from the JSON string stored in
-- `X-Amz-Meta-Contract` using EXTRACTJSONFIELD. This avoids the MinIO
-- flat-metadata limitation: the storage service serialises the entire
-- IngestionTaskDetails as a single JSON value.
--
-- ARRAY_REMOVE(ARRAY[0], 0) is the only way to produce an empty ARRAY in
-- ksqlDB — required by the Celery v2 message envelope (`args` must be []).
-- ---------------------------------------------------------------------------

CREATE OR REPLACE STREAM `artemis-ingestion-celery-tasks`
WITH (
  KAFKA_TOPIC  = 'artemis.ingestion.celery.tasks',
  VALUE_FORMAT = 'JSON',
  KEY_FORMAT   = 'JSON'
)
AS SELECT
  -- task_id as top-level field: extracted by HeaderFrom SMT → CamelHeader.id
  Records[1]->s3->object->userMetadata->`X-Amz-Meta-Task_id` AS `task_id`,

  -- Celery v2 envelope: args must be an empty array
  ARRAY_REMOVE(ARRAY[0], 0) AS `args`,

  -- ksqlDB requires the PARTITION BY expression to appear in the SELECT projection.
  -- It is then used only as the Kafka record key; ksqlDB strips it from the value.
  EXTRACTJSONFIELD(
    Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
    '$.info.namespace_id'
  ) AS `namespace_id`,

  -- kwargs: matches tasks.ingest(s3, source, upload_action, info) signature
  STRUCT(
    `s3` := STRUCT(
      `bucket` := EXTRACTJSONFIELD(
                    Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
                    '$.s3.bucket'
                  ),
      `object` := EXTRACTJSONFIELD(
                    Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
                    '$.s3.object'
                  ),
      `size`   := CAST(EXTRACTJSONFIELD(
                    Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
                    '$.s3.size'
                  ) AS BIGINT)
    ),
    `source` := STRUCT(
      `source`       := EXTRACTJSONFIELD(
                          Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
                          '$.source.source'
                        ),
      `content_type` := EXTRACTJSONFIELD(
                          Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
                          '$.source.content_type'
                        ),
      `obj_id`       := EXTRACTJSONFIELD(
                          Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
                          '$.source.obj_id'
                        ),
      `object_type`  := EXTRACTJSONFIELD(
                          Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
                          '$.source.object_type'
                        )
    ),
    `upload_action` := UCASE(EXTRACTJSONFIELD(
                          Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
                          '$.upload_action'
                        )),
    `info` := STRUCT(
      `namespace_id` := EXTRACTJSONFIELD(
                          Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
                          '$.info.namespace_id'
                        ),
      -- EXTRACTJSONFIELD returns the *string* "null" when the JSON value is null.
      -- Pydantic's UUID | None coercion rejects that string, so we normalise here.
      `group_id` := CASE
        WHEN EXTRACTJSONFIELD(
          Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
          '$.info.group_id'
        ) = 'null'
        THEN CAST(NULL AS STRING)
        ELSE EXTRACTJSONFIELD(
          Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
          '$.info.group_id'
        )
        END
    )
  ) AS `kwargs`

FROM `artemis-ingestion-storage-s3`

-- Partition by namespace_id: all events for the same namespace land on the same
-- partition, preserving relative ordering of CREATE / MODIFY / DELETE for a given
-- namespace. This sets the Kafka record key to namespace_id.
--
-- HeaderFrom$Value on the sink connector reads task_id from the message *value*,
-- not from the key, so it is unaffected by this partitioning choice.
PARTITION BY EXTRACTJSONFIELD(
  Records[1]->s3->object->userMetadata->`X-Amz-Meta-Contract`,
  '$.info.namespace_id'
)

EMIT CHANGES;


-- ---------------------------------------------------------------------------
-- 3. Re-partition by task_id → task_id becomes the Kafka record KEY
--
-- Output topic: artemis.ingestion.celery.tasks.routed
--
-- PARTITION BY STRUCT produces a named key {"task_id": "<uuid>"} directly,
-- so the RabbitMQ sink connector needs no HoistField$Key transform:
--   key.converter   = JsonConverter (deserialises the struct key)
--   value.converter = ByteArrayConverter (raw JSON bytes — no HashMap issue)
--   HeaderFrom$Key  extracts task_id directly → Kafka header CamelHeader.id
-- ---------------------------------------------------------------------------

CREATE OR REPLACE STREAM `artemis-ingestion-celery-tasks-routed`
WITH (
  KAFKA_TOPIC  = 'artemis.ingestion.celery.tasks.routed',
  VALUE_FORMAT = 'JSON',
  KEY_FORMAT   = 'JSON',
  PARTITIONS   = 1
)
AS SELECT
  -- PARTITION BY expression must appear in SELECT; ksqlDB strips it from the value.
  STRUCT(`task_id` := `task_id`) as `task_key`,
  `args`,
  `kwargs`
FROM `artemis-ingestion-celery-tasks`
PARTITION BY STRUCT(`task_id` := `task_id`)

EMIT CHANGES;


-- ===========================================================================
-- Topology B: Celery result CDC → ingested_objects + ingestion_tasks
-- ===========================================================================


-- ---------------------------------------------------------------------------
-- 4. CDC source stream: Celery task results (Debezium → apollo_celery_taskmeta)
--
-- Produced by the debezium-cdc-postgres-task-results Kafka Connect connector.
-- The ExtractNewRecordState SMT unwraps the Debezium envelope to a flat row
-- whose fields match the apollo_celery_taskmeta columns.
--
-- Relevant columns:
--   task_id  : Celery task UUID (VARCHAR 155)
--   name     : Celery task name — we filter to 'tasks.index' only
--   status   : 'SUCCESS' | 'FAILURE' | 'STARTED' | 'PENDING'
--   result   : JSON-encoded IngestionResult (see src/lib/core/ingestion/contract.py)
--              NULL on FAILURE (Celery stores the exception repr instead)
--   date_done: task completion timestamp (microseconds since Unix epoch, Debezium encoding)
--   traceback: full traceback on FAILURE; NULL on SUCCESS
-- ---------------------------------------------------------------------------

CREATE OR REPLACE STREAM `artemis-celery-taskmeta` (
    task_id   STRING,
    status    STRING,
    result    STRING,
    date_done BIGINT,
    traceback STRING,
    name      STRING
)
WITH (
    KAFKA_TOPIC  = 'apollo.ingestion.celery.results.public.apollo_celery_taskmeta',
    VALUE_FORMAT = 'JSON',
    PARTITIONS   = 1
);


-- ---------------------------------------------------------------------------
-- 5. Fan-out A: ingested objects (SUCCESS events only)
--
-- Output topic: artemis.celery.ingested_objects
-- Downstream:   debezium-jdbc-sink-ingested-objects connector
--               → upserts into the ingested_objects table (primary key: id)
--
-- All IngestionResult fields are parsed from the result TEXT column via
-- EXTRACTJSONFIELD. size_bytes is CAST to BIGINT; group_id is NULL for non-enterprise tasks.
--
-- The JDBC sink uses primary.key.mode=record_value, primary.key.fields=id.
-- The Kafka record key (Debezium integer PK) is irrelevant for the sink.
-- ---------------------------------------------------------------------------

CREATE OR REPLACE STREAM `artemis-celery-ingested-objects`
WITH (
    KAFKA_TOPIC  = 'artemis.celery.ingested_objects',
    VALUE_FORMAT = 'JSON_SR',
    KEY_FORMAT   = 'JSON_SR',
    PARTITIONS   = 1
)
AS SELECT
    -- id_key is the Kafka record key (record_key PK mode); PARTITION BY strips it from the value.
    -- id must NOT appear as a separate value projection — the JDBC sink reads it from the key struct.
    STRUCT(`id` := EXTRACTJSONFIELD(result, '$.object.id'))      AS id_key,
    EXTRACTJSONFIELD(result, '$.object.scope.namespace_id')      AS `namespace_id`,
    EXTRACTJSONFIELD(result, '$.object.source')                  AS `source`,
    EXTRACTJSONFIELD(result, '$.object.properties.object_type')  AS `object_type`,
    EXTRACTJSONFIELD(result, '$.object.properties.content_type') AS `content_type`,
    CAST(
        EXTRACTJSONFIELD(result, '$.object.properties.size_bytes') AS BIGINT
    )                                                            AS `size_bytes`,
    CASE
      WHEN EXTRACTJSONFIELD(result, '$.object.scope.group_id') = 'null'
        THEN CAST(NULL AS VARCHAR)
      ELSE EXTRACTJSONFIELD(result, '$.object.scope.group_id')
    END                                                          AS `group_id`
FROM `artemis-celery-taskmeta`
WHERE name = 'tasks.index' AND status = 'SUCCESS'
PARTITION BY STRUCT(`id` := EXTRACTJSONFIELD(result, '$.object.id'))
EMIT CHANGES;


-- ---------------------------------------------------------------------------
-- 6. Fan-out B: ingestion tasks (SUCCESS events only)
--
-- Output topic: artemis.celery.ingestion_tasks
-- Downstream:   debezium-jdbc-sink-ingestion-tasks connector
--               → upserts into the ingestion_tasks table (primary key: task_id)
--
-- namespace_id and obj_id are extracted from the IngestionResult JSON and
-- are guaranteed non-NULL for SUCCESS tasks.
--
-- KEY = the CONTRACT task_id, read from result.task_id — NOT the `task_id`
-- column. The column holds the per-subtask Celery id of THIS (`tasks.index`)
-- result row, which the caller never sees; the contract id (the `tasks.ingest`
-- entry id the storage service returned) is propagated down the chain and
-- carried in IngestionResult.task_id. Keying by it is what makes
-- `GET /tasks/{task_id}` resolve for the id the caller actually holds.
--
-- failure_reason is NULL on SUCCESS — it is projected here (and on Fan-out C)
-- so every producer into this stream/topic shares ONE value schema; the FAILURE
-- fan-out (§7b) populates it. See §7b for how FAILURE rows get a CDC-readable
-- result (a FailureRecordingTask.on_failure overwrite), since Celery's native
-- FAILURE result is an exception encoding with no task_id/namespace_id.
--
-- The JDBC sink uses primary.key.mode=record_key, primary.key.fields=task_id.
-- ---------------------------------------------------------------------------

CREATE OR REPLACE STREAM `artemis-celery-ingestion-tasks`
WITH (
    KAFKA_TOPIC  = 'artemis.celery.ingestion_tasks',
    VALUE_FORMAT = 'JSON_SR',
    KEY_FORMAT   = 'JSON_SR',
    PARTITIONS   = 1
)
AS SELECT
    -- task_id_key is the Kafka record key (record_key PK mode); PARTITION BY strips it from the value.
    -- task_id must NOT appear as a separate value projection — the JDBC sink reads it from the key struct.
    STRUCT(`task_id` := EXTRACTJSONFIELD(result, '$.task_id'))                             AS task_id_key,
    EXTRACTJSONFIELD(result, '$.object.id')                  AS `obj_id`,
    EXTRACTJSONFIELD(result, '$.object.scope.namespace_id')  AS `namespace_id`,
    status                                                   AS `status`,
    FROM_UNIXTIME(date_done / 1000)                          AS `completed_at`,
    EXTRACTJSONFIELD(result, '$.operation')                  AS `operation`,
    CAST(NULL AS VARCHAR)                                    AS `failure_reason`
FROM `artemis-celery-taskmeta`
WHERE name = 'tasks.index' AND status = 'SUCCESS'
PARTITION BY STRUCT(`task_id` := EXTRACTJSONFIELD(result, '$.task_id'))
EMIT CHANGES;


-- ---------------------------------------------------------------------------
-- 7. Fan-out C: document deletion events → ingestion_tasks
--
-- INSERT INTO artemis.celery.ingestion_tasks for tasks.delete_document
-- SUCCESS events, recording the deletion for CDC tracking.
-- ---------------------------------------------------------------------------

INSERT INTO `artemis-celery-ingestion-tasks`
SELECT
    STRUCT(`task_id` := EXTRACTJSONFIELD(result, '$.task_id'))                             AS task_id_key,
    EXTRACTJSONFIELD(result, '$.object.id')                  AS `obj_id`,
    EXTRACTJSONFIELD(result, '$.object.scope.namespace_id')  AS `namespace_id`,
    status                                                   AS `status`,
    FROM_UNIXTIME(date_done / 1000)                          AS `completed_at`,
    EXTRACTJSONFIELD(result, '$.operation')                  AS `operation`,
    CAST(NULL AS VARCHAR)                                    AS `failure_reason`
FROM `artemis-celery-taskmeta`
WHERE name = 'tasks.delete_document' AND status = 'SUCCESS'
PARTITION BY STRUCT(`task_id` := EXTRACTJSONFIELD(result, '$.task_id'));


-- ---------------------------------------------------------------------------
-- 7b. Fan-out D: task FAILURES → ingestion_tasks
--
-- INSERT INTO artemis.celery.ingestion_tasks for terminal task FAILURES, so
-- `GET /tasks/{task_id}` can distinguish "failed" from "still running"/"unknown".
--
-- A native Celery FAILURE row has result = the exception encoding
-- ({exc_type, exc_message, exc_module}) — no task_id/namespace_id — so it cannot
-- be keyed or shaped here. FailureRecordingTask.on_failure OVERWRITES that row's
-- result with a FailureRecord (contract task_id + object.scope.namespace_id +
-- operation + failure_reason) and nulls the traceback column, so the SAME
-- EXTRACTJSONFIELD(result, …) paths used for SUCCESS work. status is already
-- 'FAILURE' (projected directly, no literal needed).
--
-- DOUBLE-WRITE GUARD: mark_as_failure writes the exception-encoded result FIRST,
-- on_failure overwrites it SECOND — Debezium emits BOTH. The pre-overwrite event
-- has no $.task_id, so `EXTRACTJSONFIELD(result, '$.task_id') IS NOT NULL` drops
-- it; only the overwrite (keyed by the contract <A>) reaches the JDBC sink.
-- ---------------------------------------------------------------------------

INSERT INTO `artemis-celery-ingestion-tasks`
SELECT
    STRUCT(`task_id` := EXTRACTJSONFIELD(result, '$.task_id'))                             AS task_id_key,
    EXTRACTJSONFIELD(result, '$.object.id')                  AS `obj_id`,
    EXTRACTJSONFIELD(result, '$.object.scope.namespace_id')  AS `namespace_id`,
    status                                                   AS `status`,
    FROM_UNIXTIME(date_done / 1000)                          AS `completed_at`,
    EXTRACTJSONFIELD(result, '$.operation')                  AS `operation`,
    EXTRACTJSONFIELD(result, '$.failure_reason')             AS `failure_reason`
FROM `artemis-celery-taskmeta`
WHERE status = 'FAILURE'
  AND (
    name = 'tasks.fetch_and_parse'
    OR name = 'tasks.submit_parse'
    OR name = 'tasks.poll_parse'
    OR name = 'tasks.resolve_parse'
    OR name = 'tasks.poll_resolve'
    OR name = 'tasks.index'
    OR name = 'tasks.delete_document'
  )
  AND EXTRACTJSONFIELD(result, '$.task_id') IS NOT NULL
PARTITION BY STRUCT(`task_id` := EXTRACTJSONFIELD(result, '$.task_id'));


-- ---------------------------------------------------------------------------
-- 8. Tombstone fan-out: document deletions → ingested_objects (DELETE)
--
-- Produces a tombstone (null-value record) to artemis.celery.ingested_objects
-- for each tasks.delete_document SUCCESS event.  The Debezium JDBC sink
-- (configured with delete.enabled=true) sees the null value and DELETEs the
-- row identified by the key.
--
-- VALUE_FORMAT='KAFKA' + CAST(NULL AS VARCHAR) is the ksqlDB idiom for
-- producing a tombstone: the value is serialised as raw null bytes rather than
-- a JSON schema payload, which is exactly what Debezium's delete.enabled mode
-- requires.  The key remains JSON_SR to match the schema the JDBC sink expects
-- when reading the primary key in record_key mode.
--
-- Two CSAS can share the same output Kafka topic provided their stream names
-- differ — Stream 5 (upserts, JSON_SR value) and Stream 8 (tombstones, KAFKA
-- value) both target artemis.celery.ingested_objects.
-- ---------------------------------------------------------------------------

CREATE OR REPLACE STREAM `artemis-celery-ingested-objects-deletes`
WITH (
    KAFKA_TOPIC  = 'artemis.celery.ingested_objects',
    VALUE_FORMAT = 'KAFKA',
    KEY_FORMAT   = 'JSON_SR',
    PARTITIONS   = 1
)
AS SELECT
    STRUCT(`id` := EXTRACTJSONFIELD(result, '$.object.id')) AS id_key,
    CAST(NULL AS VARCHAR)
FROM `artemis-celery-taskmeta`
WHERE name = 'tasks.delete_document' AND status = 'SUCCESS'
PARTITION BY STRUCT(`id` := EXTRACTJSONFIELD(result, '$.object.id'))
EMIT CHANGES;
