"""
Custom Ubuntu development and deployment images with custom configurations and utilities

Based on:
https://github.com/GoogleContainerTools/rules_distroless/blob/main/examples/ubuntu_snapshot/BUILD.bazel
"""

load("@container_structure_test//:defs.bzl", "container_structure_test")  # @unused
load("@rules_distroless//distroless:defs.bzl", "group", "passwd")
load("@rules_oci//oci:defs.bzl", "oci_image", oci_load = "oci_tarball")
load("@tar.bzl", "tar")

COMPATIBLE_WITH = select({
    "@platforms//cpu:x86_64": ["@platforms//cpu:x86_64"],
    "@platforms//cpu:arm64": ["@platforms//cpu:arm64"],
}) + [
    "@platforms//os:linux",
]

passwd(
    name = "passwd",
    entries = [
        {
            "uid": 0,
            "gid": 0,
            "home": "/root",
            "shell": "/bin/bash",
            "username": "r00t",
        },
        {
            "uid": 100,
            "gid": 65534,
            "home": "/home/_apt",
            "shell": "/usr/sbin/nologin",
            "username": "_apt",
        },
    ],
)

group(
    name = "group",
    entries = [
        {
            "name": "root",
            "gid": 0,
        },
        {
            "name": "_apt",
            "gid": 65534,
        },
    ],
)

tar(
    name = "sh",
    mtree = [
        # needed as dpkg assumes sh is installed in a typical debian installation.
        "./bin/sh type=link link=/bin/bash",
    ],
)

oci_image(
    name = "noble",
    base = "@ubuntu",
    target_compatible_with = COMPATIBLE_WITH,
    tars = [
        ":sh",
        ":passwd",
        ":group",
        "@noble//:noble",
    ],
    visibility = ["//src:__subpackages__"],
)

# here for debug purposes (checking for deps and structure)
oci_load(
    name = "noble.tarball",
    image = ":noble",
    repo_tags = [
        "apollo/noble:latest",
    ],
    target_compatible_with = COMPATIBLE_WITH,
)
