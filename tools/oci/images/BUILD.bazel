kafka_connect_init_image(
    name = "kafka-connect-init",
    # we use curl to configure connectors to Kafka Connect via its REST API
    base = "@curl",
    # connector instance configuration JSON files will end up
    # under /config/ directory in the resulting image
    connector_config_dir = "config",
    connectors = [
        # OT GitHub Pull Request Comments -> Kafka
        # ":camel-ot-github-pullrequest-comment-source-kafka-connector",

        # Files -> Kafka (Files)
        ":camel-file-source-kafka-connector-test",
        ":camel-file-watch-kafka-connector-test",
        ":camel-file-source-kafka-connector-opentitan",
        ":camel-file-watch-kafka-connector-opentitan",
        ":camel-file-source-kafka-connector-akko",
        ":camel-file-watch-kafka-connector-akko",
        ":camel-file-source-kafka-connector-tavor",
        ":camel-file-watch-kafka-connector-tavor",

        # Kafka (Files) -> S3
        ":http-sink-connector-file-watch-to-s3-upload",

        # Kafka (S3) -> file operations SQL table
        ":debezium-jdbc-sink-connector-file-ops-table",

        # File operations SQL table + (task_id -> headers) -> Kafka (CDC)
        ":debezium-cdc-postgres-connector-file-ops",

        # Kafka (CDC) -> Celery (RabbitMQ task queues)
        ":camel-rabbitmq-sink-connector-ingestion-task-queue-library",
        ":camel-rabbitmq-sink-connector-ingestion-task-queue-private",

        # Celery task results -> Kafka (CDC)
        ":debezium-cdc-postgres-task-results",

        # Kafka (CDC) -> Private File Table (SQL)
        ":debezium-jdbc-sink-private-files-table",
        ":debezium-jdbc-sink-library-files-table",

        # Private File Table (SQL) -> Kafka
        ":debezium-cdc-postgres-private-files",

        # Kafka (private files auto delete) -> backend storage service (HTTP)
        ":camel-http-sink-private-files-auto-delete",
    ],
    # this is where the initialization script will run from inside the container
    # the entrypoint is currently fixed to "sh -c /<exec_dir>/init-script.sh"
    exec_dir = "etc/bin",  # nit: does this actually have to be exposed to the user?
)

