kafka_connect_connector_instance(
    name = "camel-http-sink-private-files-auto-delete",
    connector_config = {
        "connector.class": "org.apache.camel.kafkaconnector.httpsink.CamelHttpsinkSinkConnector",
        "tasks.max": 1,

        # pulling messages from a KSQLDB stream that processes
        # CDC events from public.files tables and convert them
        # to a format suitable for the /upload/auto input schema
        # in the backend indexing storage service:
        #   {
        #       "doc_ids": List[UUID],
        #       "user_id": UUID,
        #       "chat_session_id": UUID,
        #   }
        #
        #
        #
        "topics": "apollo.ingestion.storage.private.auto.deleted",

        # Camel don't play nice with Json-ish converters, so use a plain string converter
        # for above topic messages
        "value.converter": "org.apache.kafka.connect.storage.StringConverter",
        "value.converter.schemas.enable": False,
        "key.converter": "org.apache.kafka.connect.storage.StringConverter",
        "key.converter.schemas.enable": False,

        # Using PUT message here because Camel Http sink connector refuses to send
        # an HTTP body for a DELETE request unless a special flag is chosen
        # (https://camel.apache.org/components/4.10.x/http-component.html#_endpoint_query_option_deleteWithBody)
        # and I don't know how to set it for this connector
        "camel.kamelet.http-sink.url": "http://backend-indexing-storage:8080/upload/auto",
        "camel.kamelet.http-sink.method": "PUT",
    },
    connector_name = "CamelHttpSinkConnector__PrivateFilesAutoDelete",
)

