        "value.converter": "io.confluent.connect.json.JsonSchemaConverter",
        "value.converter.schemas.enable": True,
        "value.converter.schema.registry.url": "http://schemaregistry:8081",
        "key.converter": "io.confluent.connect.json.JsonSchemaConverter",
        "key.converter.schemas.enable": True,
        "key.converter.schema.registry.url": "http://schemaregistry:8081",
        "connection.password": "debezium",
        "connection.username": "debezium",
        "connection.url": "jdbc:postgresql://postgres:5432/documents",

        # sink results from the topic to the public.files table
        "collection.name.format": "files",

        # primary key configuration
        # Messages are expected to have these fields (id, user_id, chat_id)
        # in the message key
        "primary.key.mode": "record_key",
        "primary.key.fields": "id,user_id,chat_id",

        # updates on conflict, allows deletion from the table
        "insert.mode": "upsert",
        "delete.enabled": "true",
        "schema.evolution": "basic",
        "use.time.zone": "UTC",
    },
    connector_name = "DebeziumJdbcSinkConnector__TaskResultToFilesPrivateTable",
)

