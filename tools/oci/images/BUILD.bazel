kafka_connect_connector_instance(
    name = "http-sink-connector-file-watch-to-s3-upload",
    connector_config = {
        "connector.class": "io.aiven.kafka.connect.http.HttpSinkConnector",
        "errors.deadletterqueue.topic.name": "artemis.ingestion.dlq.http-sink.library.files",
        "errors.deadletterqueue.topic.replication.factor": 1,
        "topics": ",".join(
            [
                "apollo.ingestion.watchdog.library.{file_topic}".format(
                    file_topic = file_topic,
                )
                for file_topic in [
                    "changes",
                    "files",
                ]
            ],
        ),
        "http.authorization.type": "none",
        # This is the module that will pick up the
        # messages from the watchdog service and store
        # the pointed document to S3 storage
        "http.url": "http://backend-indexing-storage:8080/library",
        # Here we set batching to True, because the ingestion service
        # can will eventually send a batch of files to be ingested to the
        # ingestion backend
        "batching.enabled": False,
        # Send up to 4 files for ingestion at once
        "tasks.max": "1",
        # Key is expected to a plain string, so we use a StringConverter
        "key.converter": "org.apache.kafka.connect.storage.StringConverter",
        # Using a string converter for the value, because the JSON deserializer
        # can't handle unescaped "/" characters in the JSON string
        "value.converter": "org.apache.kafka.connect.storage.StringConverter",
        "key.converter.schemas.enable": False,
        "value.converter.schemas.enable": False,

        # Value transformations
        # 1. <path> (bytes) -> {"path": <path>} (JSON)
        # 2. {"path": <path>} -> {"path": <path>, "namespace": <namespace>, "reason": <reason>}
        "transforms": ",".join([
            "HoistValueField",
            "CopyNTILNamespaceHeadersToValue",
            "RemovePathFieldForExistingFiles",
            "InsertFilePathFromHeaderForExistingFiles",
        ]),
        "predicates": "IsExistingFileTopic",

        # Formats the Kafka message to the format the indexing service expects
        # 1. <path> (bytes) -> {"path": <path>} (JSON)
        "transforms.HoistValueField.type": "org.apache.kafka.connect.transforms.HoistField$Value",
        "transforms.HoistValueField.field": "path",

        # 2. {"path": <path>} -> {"path": <path>, "namespace": <namespace>, "reason": <reason>}
        "transforms.CopyNTILNamespaceHeadersToValue.type": "io.debezium.transforms.HeaderToValue",
        "transforms.CopyNTILNamespaceHeadersToValue.headers": "NTILHeader.namespace,CamelHeader.CamelFileEventType",
        "transforms.CopyNTILNamespaceHeadersToValue.fields": "namespace,reason",
        "transforms.CopyNTILNamespaceHeadersToValue.operation": "copy",

        # Small custom adjustments from files coming out of the apollo.ingestion.watchdog.library.files topic
        # These have a "path" field that is not formatted correctly, and thakes the form "GenerticFile[<path>]"
        # Which is not suitable for us, so we drop the field and then properly insert it from the header

        # drop the "path" field from the value as it's ill formatted by the source connector
        # and use the absolute path from the CamelHeader.CamelFileAbsolutePath header instead
        "transforms.RemovePathFieldForExistingFiles.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
        "transforms.RemovePathFieldForExistingFiles.exclude": "path",
        "transforms.RemovePathFieldForExistingFiles.predicate": "IsExistingFileTopic",
        "transforms.InsertFilePathFromHeaderForExistingFiles.type": "io.debezium.transforms.HeaderToValue",
        "transforms.InsertFilePathFromHeaderForExistingFiles.headers": "CamelHeader.CamelFileAbsolutePath",
        "transforms.InsertFilePathFromHeaderForExistingFiles.fields": "path",
        "transforms.InsertFilePathFromHeaderForExistingFiles.operation": "copy",
        "transforms.InsertFilePathFromHeaderForExistingFiles.predicate": "IsExistingFileTopic",
        "predicates.IsExistingFileTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
        "predicates.IsExistingFileTopic.pattern": "apollo\\.ingestion\\.watchdog\\.library\\.files",
    },
    connector_name = "AivenHttpSinkConnector__FileSourceWatcherToIngestionController",
)

# connection between S3 storage to ingestion controller
kafka_connect_connector_instance(
    name = "debezium-jdbc-sink-connector-file-ops-table",
    connector_config = {
        "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
        "tasks.max": "1",
        # A topic created by KSQLDB processing streams
        "topics": "apollo.ingestion.storage.s3.library.processed",
        # Key and value are written as JSON Schema objects by KSQLDB
        # see corresponding KSQLDB stream
        "value.converter": "io.confluent.connect.json.JsonSchemaConverter",
        "value.converter.schemas.enable": True,
        "value.converter.schema.registry.url": "http://schemaregistry:8081",
        "key.converter": "io.confluent.connect.json.JsonSchemaConverter",
        "key.converter.schemas.enable": True,
        "key.converter.schema.registry.url": "http://schemaregistry:8081",

        # name of the table in the database to write to
        "collection.name.format": "file_operations",

        # Database connection properties
        "connection.url": "jdbc:postgresql://postgres:5432/documents",
        "connection.password": "debezium",  # TODO: change this to a proper secret
        "connection.username": "debezium",  # TODO: change this to a non-privileged user

        # Debzeium JDBC sink connector properties
        "schema.evolution": "basic",
        "insert.mode": "upsert",

        # This allows the connector to delete records
        "delete.enabled": "false",
        # Tells the connector to use the message key to find the table's primary key
        # and the value to delete
        "primary.key.mode": "record_key",
        # The actualy name of the field inside the message key (it's called "key" in the JSON struct to denote the object key)
        "primary.key.fields": "task_id",
        "use.time.zone": "UTC",
    },
    connector_name = "DebeziumJdbcSinkConnector__S3ToFilesOpsTable",
)

kafka_connect_connector_instance(
    name = "debezium-cdc-postgres-connector-file-ops",
    connector_config = {
        "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
        # Consider changing this to "filtered" to allow Debezium to create publications automatically
        # The 'debezium' user has ownership of the table so it can create publications
        "key.converter": "org.apache.kafka.connect.json.JsonConverter",
        "key.converter.schemas.enable": "false",
        "value.converter": "org.apache.kafka.connect.json.JsonConverter",
        "value.converter.schemas.enable": "false",

        # PostgreSQL connection properties
        "database.user": "debezium",
        "database.password": "debezium",  # TODO: change this to a proper secret
        "database.dbname": "documents",
        "database.port": "5432",
        "database.hostname": "postgres",

        # Debezium PostgreSQL connector properties
        # Creates the topic 'apollo.ingestion.operations.bookkeeper.public.file_operations'
        "topic.prefix": "apollo.ingestion.operations.bookkeeper",
        "table.include.list": "public.file_operations",

        # Use pgoutput plugin for logical decoding
        "plugin.name": "pgoutput",

        # Publication configuration
        "publication.name": "files_operation_publication",
        # TODO: consider changing this to "filtered" to allow Debezium to create publications automatically
        # public.file_operations is ownded by the 'debezium' user, so it can create publications
        "publication.autocreate.mode": "disabled",

        # Subscrition configuration
        "slot.name": "apollo_library_files_rep_slot",

        # Use the ExtractNewRecordState transformation to extract the new record state
        "transforms": "unwrap,taskIdToHeaders",
        "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
        "transforms.unwrap.delete.tombstone.handling.mode": "rewrite",  # removes the tombstone messages and adds a '__deleted' field to the message value

        # This transformation will take the 'task_id' field from the message value
        # and copy it to the message headers as 'Camel.task_id'
        # This is a preparation for the RabbitMQ sink connector
        # which sinks messages into Celery. We do this because to Celery's message protocol V2
        # requires the task ID to be present in the headers of the message:
        #   See: https://docs.celeryq.dev/en/stable/internals/protocol.html#version-2
        "transforms.taskIdToHeaders.type": "org.apache.kafka.connect.transforms.HeaderFrom$Value",
        "transforms.taskIdToHeaders.fields": "task_id",
        "transforms.taskIdToHeaders.headers": "CamelHeader.id",
        "transforms.taskIdToHeaders.operation": "move",
    },
    connector_name = "DebeziumPostgresSourceConnector__FileOpsBookkeeperToIngestion",
)

# define the configuration for the RabbitMQ sink connectors
# for events produced via S3 storage events and pushed to Kafka
[
    kafka_connect_connector_instance(
        name = "camel-rabbitmq-sink-connector-ingestion-task-queue-{namespace}".format(namespace = namespace),
        connector_config = {
            "connector.class": "org.apache.camel.kafkaconnector.springrabbitmqsink.CamelSpringrabbitmqsinkSinkConnector",
            "topics": "apollo.ingestion.celery.tasks.{namespace}".format(namespace = namespace),
            "value.converter.schemas.enable": "false",
            "tasks.max": "1",

            # RabbitMQ connection properties
            "camel.kamelet.spring-rabbitmq-sink.host": "rabbitmq",
            "camel.kamelet.spring-rabbitmq-sink.port": "5672",
            "camel.kamelet.spring-rabbitmq-sink.password": "apollo",
            "camel.kamelet.spring-rabbitmq-sink.username": "apollo",

            # Virtual Host, exchange and queues properties
            # Apollo has a single RabbitMQ virtual host for all namespaces
            "camel.kamelet.spring-rabbitmq-sink.vhost": "apollo",
            # We a have a single exchange for all namespaces
            # Messages will be routed to the appropriate queue using the routing key
            # All ingestion messages will be routed via the the "ingestion" exchange
            "camel.kamelet.spring-rabbitmq-sink.exchangeName": "ingestion",

            # Messages will be routed to the appropriate queue using the routing key
            # For example: a connector with a configured routing key "library" will send
            # the Kafka topic messages to the "apollo.ingestion.library" queue
            "camel.kamelet.spring-rabbitmq-sink.routingKey": "{namespace}".format(namespace = namespace),
            "camel.kamelet.spring-rabbitmq-sink.queues": "apollo.ingestion.{namespace}".format(namespace = namespace),

            # Queue declaration happens automatically
            # when the connector starts, so we don't need to declare them manually
            "camel.kamelet.spring-rabbitmq-sink.autoDeclareProducer": "true",

            # We need to add the two following fields to the headers in order for Celery to acdept messages
            # sinked by this connector
            # 1. CamelHeader.id - taken care of by the CDC connector which puts the task_id in the headers
            # 2. CamelHeader.task - the name of the Celery task that recieves the message
            # 3. CamelHeader.CamelRabbitmqContentType - the content type of the message, which is "application/json"
            #
            #    This is required by Celery to process the message correctly
            "transforms": "insertTaskNameHeader,insertCamelContentTypeHeader",

            # 1. CamelHeader.task - the name of the Celery task that recieves the message
            "transforms.insertTaskNameHeader.type": "org.apache.kafka.connect.transforms.InsertHeader",
            "transforms.insertTaskNameHeader.header": "CamelHeader.task",
            "transforms.insertTaskNameHeader.value.literal": "tasks.ingestion.{namespace}".format(namespace = namespace),

            # 2. CamelHeader.CamelRabbitmqContentType - the content type of the message, which is "application/json"
            #    This is required by Celery to process the message correctly
            "transforms.insertCamelContentTypeHeader.type": "org.apache.kafka.connect.transforms.InsertHeader",
            "transforms.insertCamelContentTypeHeader.header": "CamelHeader.CamelSpringRabbitmqContentType",
            "transforms.insertCamelContentTypeHeader.value.literal": "application/json",
        },
        connector_name = "CamelRabbitMQSinkConnector__KSQLDB{namespace}TasksToTaskQueue".format(namespace = namespace.capitalize()),
    )
    for namespace in [
        "library",
        "private",
    ]
]

