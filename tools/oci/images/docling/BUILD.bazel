"""Patched docling-serve image.

Layers a one-line fix for an upstream docling-jobkit bug on top of the vanilla
`docling-serve-cu128:v1.29.0` base: `SourceChunkConvertRequest.chunk` is typed as
the *subscripted* generic `DocumentChunk[Any, Any]` instead of the bare
`DocumentChunk` class. Pydantic coerces the field's value into a dynamically
created parameterized class with no stable, importable qualname, which Ray
Serve's cross-replica-process pickling of that value (coordinator -> converter
replica) can't reconstruct -- every S3-source fan-out call fails instantly with
`ray.exceptions.RaySystemError: System error: 'type'`, before the converter ever
runs. `models.py` here is that upstream file with the field un-subscripted; every
other byte of the base image is untouched (no entrypoint/cmd override -- this
tar layer only overlays the one file, same as a plain `COPY` in a Dockerfile).

Root cause + fix pending upstream: https://github.com/docling-project/docling-jobkit
"""

load("@aspect_bazel_lib//lib:tar.bzl", "mtree_mutate", "mtree_spec", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", oci_load = "oci_tarball")
load("//tools/oci:stamped_tags.bzl", "stamped_tags")

# Real site-packages path inside docling-serve-cu128:v1.29.0 (UBI + Python 3.12).
_JOBKIT_RAY_MODELS_DIR = "opt/app-root/lib64/python3.12/site-packages/docling_jobkit/orchestrators/ray"

# Referenced cross-package by //tests/oci/images/docling's assert_contains check.
exports_files(["models.py"])

mtree_spec(
    name = "models.py.spec",
    srcs = [":models.py"],
)

mtree_mutate(
    name = "models.py.mtree",
    mtree = ":models.py.spec",
    package_dir = _JOBKIT_RAY_MODELS_DIR,
    strip_prefix = package_name(),
)

tar(
    name = "models.py.pkg",
    srcs = [":models.py"],
    mtree = ":models.py.mtree",
    # Referenced cross-package by //tests/oci/images/docling's assert_archive_contains
    # (tar-placement) check.
    visibility = ["//tests/oci/images/docling:__pkg__"],
)

oci_image(
    name = "image",
    base = "@docling-serve-cu128",
    tars = [":models.py.pkg"],
    visibility = ["//tools/oci/images:__pkg__"],
)

stamped_tags(
    name = "tarball.tags",
    dev_tags = ["latest"],
    repository = "artemis/docling-serve-ray-patched",
)

oci_load(
    name = "tarball",
    image = ":image",
    # use this tag as image name for docling-serve / ray-head / ray-worker in
    # docker-compose.yaml
    repo_tags = ":tarball.tags",
    visibility = [
        "//tests/oci/images/docling:__pkg__",
        "//tools/oci/images:__pkg__",
    ],
)

# Reproducible checks that the patch is actually what ships live in
# //tests/oci/images/docling, not here — see that package for the
# assert_contains / assert_archive_contains / container_structure_test targets.
