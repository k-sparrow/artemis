#
# BM25 (Qdrant/bm25) model asset layer for OCI images.
#
# Files are copied from the HuggingFace Hub cache with symlinks resolved
# (cp -rL) so Bazel glob() can track them as regular files.
#
# The genrule remaps:
#   tools/assets/fastembed/models--Qdrant--bm25/...
#     → opt/fastembed/models--Qdrant--bm25/...
# inside the tar, so the layer lands at /opt/fastembed inside the container.
# Set FASTEMBED_CACHE_PATH=/opt/fastembed in the image env to point fastembed here.

package(default_visibility = ["//visibility:public"])

_BM25_SRCS = glob(["models--Qdrant--bm25/**"])

filegroup(
    name = "bm25_model_files",
    srcs = _BM25_SRCS,
)

genrule(
    name = "bm25_model_layer",
    srcs = _BM25_SRCS,
    outs = ["bm25_model_layer.tar"],
    cmd = """
        tar cf $@ \
            --transform='s|^tools/assets/fastembed/|opt/fastembed/|' \
            $(SRCS)
    """,
)
