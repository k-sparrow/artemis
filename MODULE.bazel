)

http_archive(
    name = "camel-file-source-kafka-connector-4.10.3",
    build_file = "@//tools/kafka/connectors:generic.BUILD",
    integrity = "sha256-sO8Maax0iWHuN7Gh5wNydNg5i+GL2V0bzmStJVdNdSg=",
    url = "https://repo.maven.apache.org/maven2/org/apache/camel/kafkaconnector/camel-file-kafka-connector/4.10.3/camel-file-kafka-connector-4.10.3-package.tar.gz",
