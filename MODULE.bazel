module(
    name = "artemis",
    version = "0.0.1",
    compatibility_level = 1,
)

PY_RULES_VERSION = "1.0.0"

PY_VERSION = "3.12"

ASPECT_RULES_LINT_VERSION = "1.0.2"

BUILDIFIER_PREBUILT_VERSION = "7.3.1"

# declare dependency on Bazel's Python rules
bazel_dep(name = "rules_python", version = PY_RULES_VERSION)

# ------------------ LINT & FORMAT ----------------------------------------------
bazel_dep(name = "aspect_rules_lint", version = ASPECT_RULES_LINT_VERSION)
bazel_dep(name = "buildifier_prebuilt", version = BUILDIFIER_PREBUILT_VERSION)
# -------------------------------------------------------------------------------

# ------------------ PYTHON GAZELLE ---------------------------------------------
# The following stanza defines the dependency rules_python_gazelle_plugin.
# For typical setups you set the version.
bazel_dep(name = "rules_python_gazelle_plugin", version = "0.36.0")

# The following stanza defines the dependency gazelle.
bazel_dep(name = "gazelle", version = "0.39.1", repo_name = "bazel_gazelle")
# -------------------------------------------------------------------------------

# ------------------ Containerization -------------------------------------------
bazel_dep(name = "aspect_bazel_lib", version = "2.19.3")
bazel_dep(name = "container_structure_test", version = "1.16.0")
bazel_dep(name = "aspect_rules_py", version = "1.8.4")
bazel_dep(name = "rules_oci", version = "1.8.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_multirun", version = "0.9.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_distroless", version = "0.6.2")
bazel_dep(name = "tar.bzl", version = "0.9.0")
# -------------------------------------------------------------------------------

# Next, initialize the hermetic Python toolchain using this extension.
# This will allow running Python separated from the system interpreter
# and without manually creating a virtual environment
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = PY_VERSION,
)
use_repo(python, "python_3_12")

# Register an already-defined toolchain so that Bazel can use it during toolchain resolution.
register_toolchains(
    "@python_3_12//:all",
)

# This extension allows a user to create modifications to how rules_python
# creates different wheel repositories.  Different attributes allow the user
# to modify the BUILD file, and copy files.
# See @rules_python//python/extensions:whl_mods.bzl attributes for more information
# on each of the attributes.
# You are able to set a hub name, so that you can have different modifications of the same
# wheel in different pip hubs.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# fetch 3rd party libraries
pip.parse(
    timeout = 3600,
    hub_name = "pip",
    python_version = PY_VERSION,
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pip")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
# amd64 only across every pull below: we don't build/deploy for arm64, and at
# least two of these (cp-ksqldb-cli, docling-serve-cu128) don't even publish a
# "linux/arm64/v8"-matching manifest variant (no `variant` field set on their
# arm64 descriptor) — confirmed via `docker manifest inspect`, not transient.
# A declared-but-unmatchable platform breaks eager whole-graph evaluation
# (`bazel query`, `bazel build //...`) even though scoped single-target builds
# never touched it.
oci.pull(
    name = "ubuntu",
    digest = "sha256:b359f1067efa76f37863778f7b6d0e8d911e3ee8efa807ad01fbf5dc1ef9006b",
    image = "ubuntu",
    platforms = [
        "linux/amd64",
    ],
    tag = "latest",
)
oci.pull(
    name = "postgres",
    digest = "sha256:5af45ac79f38cb3b0584ff4ff222917edbdde309d187aa69aa91671807e6bc61",
    image = "postgres",
    platforms = [
        "linux/amd64",
    ],
    tag = "17.2-bullseye",
)
oci.pull(
    name = "cp-kafka-connect",
    digest = "sha256:93c0175e000ca49be814afe10cc42da281b475e937d20180e56c390667947636",
    image = "docker.io/confluentinc/cp-kafka-connect-base",
    platforms = [
        "linux/amd64",
    ],
    tag = "7.9.0",
)
oci.pull(
    name = "cp-ksqldb-cli",
    digest = "sha256:68a87a469e577c6b5c02f1a39a80d901f5af35a5027609ee77d525d010ef8fa7",
    image = "index.docker.io/confluentinc/cp-ksqldb-cli",
    platforms = [
        "linux/amd64",
    ],
    tag = "7.9.1",
)
oci.pull(
    name = "curl",
    digest = "sha256:d43bdb28bae0be0998f3be83199bfb2b81e0a30b034b6d7586ce7e05de34c3fd",
    image = "index.docker.io/curlimages/curl",
    platforms = [
        "linux/amd64",
    ],
    tag = "8.13.0",
)
oci.pull(
    name = "docling-serve-cu128",
    digest = "sha256:6b27338eea4981a8c51c3cdccda83441a62053ce5cf708f4fdf70aad5f3c10e8",
    image = "ghcr.io/docling-project/docling-serve-cu128",
    platforms = [
        "linux/amd64",
    ],
    tag = "v1.29.0",
)

# make images ready for use as third-party repos
use_repo(
    oci,
    "cp-kafka-connect",
    "cp-ksqldb-cli",
    "curl",
    "docling-serve-cu128",
    "postgres",
    "ubuntu",
)

apt = use_extension(
    "@rules_distroless//apt:extensions.bzl",
    "apt",
    dev_dependency = True,
)
apt.install(
    name = "noble",
    lock = "//tools/oci/images/ubuntu:noble.lock.json",
    manifest = "//tools/oci/images/ubuntu:noble.yaml",
)
use_repo(apt, "noble")

